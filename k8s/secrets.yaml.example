# This is a template file. DO NOT commit actual secrets!
# Create the actual secret using kubectl or from a file

# Option 1: Create secret from literal values
# kubectl create secret generic capacity-chatbot-secrets \
#   --from-literal=openai-api-key='your-openai-key' \
#   --from-literal=langsmith-api-key='your-langsmith-key' \
#   --from-literal=mykaarma-mkid='your-mkid' \
#   --from-literal=default-department-uuid='your-dept-uuid' \
#   --from-literal=default-dealer-uuid='your-dealer-uuid' \
#   --namespace=default

# Option 2: Create secret from file
# kubectl create secret generic capacity-chatbot-secrets \
#   --from-file=openai-api-key=./secrets/openai-api-key.txt \
#   --from-file=langsmith-api-key=./secrets/langsmith-api-key.txt \
#   --from-file=mykaarma-mkid=./secrets/mykid.txt \
#   --from-file=default-department-uuid=./secrets/dept-uuid.txt \
#   --from-file=default-dealer-uuid=./secrets/dealer-uuid.txt \
#   --namespace=default

# Option 3: Create secret from YAML (base64 encoded)
# Use: echo -n 'your-secret-value' | base64
# Then create secrets.yaml with the base64 values

apiVersion: v1
kind: Secret
metadata:
  name: capacity-chatbot-secrets
  namespace: default
type: Opaque
stringData:
  openai-api-key: "your-openai-api-key-here"
  langsmith-api-key: "your-langsmith-api-key-here"
  mykaarma-mkid: "your-mykid-here"
  default-department-uuid: "your-department-uuid-here"
  default-dealer-uuid: "your-dealer-uuid-here"

