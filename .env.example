# ═══════════════════════════════════════════════════════════════════════════════
# ANTHROPIC API (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL=claude-sonnet-4-5-20250929

# ═══════════════════════════════════════════════════════════════════════════════
# LANGSMITH (REQUIRED for persistence with langgraph up)
# Get it from: https://smith.langchain.com
# ═══════════════════════════════════════════════════════════════════════════════
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=capacity-chatbot

# ═══════════════════════════════════════════════════════════════════════════════
# KAPPOINTMENT API
# ═══════════════════════════════════════════════════════════════════════════════
KAPPOINTMENT_API_BASE_URL=https://your-kappointment-server.example.com
KAPPOINTMENT_API_TIMEOUT=30

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# NOTE: The following values are NOT configured here - they MUST be provided
# by the UI client in each request:
#
#   - department_uuid (from UI state)
#   - dealer_uuid (from UI state)  
#   - mkid (from UI state)
#   - cached_data (transport_options, advisors, teams from UI)
#
# This ensures the chatbot works with the correct dealer context.
# ═══════════════════════════════════════════════════════════════════════════════
