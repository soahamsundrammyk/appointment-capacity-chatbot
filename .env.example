# OpenAI API Key (REQUIRED)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith Configuration (Optional but Recommended)
# Get it from: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=capacity-chatbot

# KAppointment API Configuration
# This is your local kappointment-api server
# For local development, it's usually http://localhost:8080
# For production, use your actual kappointment-api URL
KAPPOINTMENT_API_BASE_URL=http://localhost:8080
KAPPOINTMENT_API_TIMEOUT=30

# Conversation Storage (SQLite)
SQLITE_DB_PATH=./checkpoints.sqlite

# Logging
LOG_LEVEL=INFO
